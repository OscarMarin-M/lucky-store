    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"name\" TEXT NOT NULL, \"sku\" TEXT NULL, \"units_per_box\" INTEGER NOT NULL DEFAULT 1, \"stock_units\" INTEGER NOT NULL DEFAULT 0, \"avg_cost_raw\" INTEGER NOT NULL DEFAULT 0, \"suggested_price_unit_cents\" INTEGER NOT NULL DEFAULT 0, \"suggested_price_box_cents\" INTEGER NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"min_stock_units\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "purchases",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"purchases\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"date\" TEXT NOT NULL, \"supplier\" TEXT NULL, \"notes\" TEXT NULL, \"total_cents\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "purchase_lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"purchase_lines\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"purchase_id\" TEXT NOT NULL REFERENCES purchases (id), \"product_id\" TEXT NOT NULL REFERENCES products (id), \"quantity\" INTEGER NOT NULL, \"presentation\" TEXT NOT NULL, \"units_base\" INTEGER NOT NULL, \"line_total_cents\" INTEGER NOT NULL, \"unit_cost_raw\" INTEGER NOT NULL, \"units_per_box\" INTEGER NULL, \"expiry_from\" TEXT NULL, \"expiry_to\" TEXT NULL, \"lot_code\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
